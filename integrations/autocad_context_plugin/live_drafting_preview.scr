(setq aieng-bridge (getenv "AI_ENGINEER_AUTOCAD_BRIDGE"))
(setq aieng-startup-log (getenv "AI_ENGINEER_AUTOCAD_STARTUP_LOG"))
(defun aieng-log-marker (text / stream)
  (if (and aieng-startup-log (/= aieng-startup-log ""))
    (progn
      (setq stream (open aieng-startup-log "a"))
      (if stream (progn (write-line text stream) (close stream)))
    )
  )
)
(aieng-log-marker "SCRIPT_STARTED=1")
(setq aieng-old-trusted (getvar "TRUSTEDPATHS"))
(setvar "TRUSTEDPATHS" (vl-filename-directory aieng-bridge))
(command "_.NETLOAD" aieng-bridge)
(aieng-log-marker "NETLOAD_RETURNED=1")
(setvar "TRUSTEDPATHS" aieng-old-trusted)
_.AIENGPALETTE
(aieng-log-marker "PALETTE_RETURNED=1")
(princ "\nAI-Engineer palette ready. Run AIENGCONTEXT after an explicit selection, then open Quantity Takeoff.\n")
(princ)
